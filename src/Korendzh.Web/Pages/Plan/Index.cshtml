@page
@model Korendzh.Web.Pages.Plan.IndexModel
@{
    ViewData["Title"] = "Мой план";
    var ru = new System.Globalization.CultureInfo("ru-RU");
}
<div class="toolbar">
    <h1>План загрузки — @Model.WorkerName</h1>
    <div class="actions">
        <a class="btn" asp-page="/Plan/Bulk" asp-route-workerId="@Model.WorkerId">Заполнить по шаблону</a>
        @if (Model.IsManagerOrAdminView)
        {
            <a class="btn secondary" asp-page="/Plan/Workers">← Все работники</a>
        }
    </div>
</div>

<form method="get" class="card">
    <div class="row">
        <div class="field">
            <label>Месяц</label>
            <input type="month" name="month" value="@Model.MonthStart.ToString("yyyy-MM")" onchange="this.form.submit()" />
        </div>
        @if (Model.IsManagerOrAdminView)
        {
            <input type="hidden" name="workerId" value="@Model.WorkerId" />
        }
    </div>
</form>

<form method="post" class="card">
    <input type="hidden" name="WorkerId" value="@Model.WorkerId" />
    <input type="hidden" name="MonthStart" value="@Model.MonthStart.ToString("yyyy-MM-dd")" />

    <p class="muted">
        План = @Model.TotalPlannedHours.ToString("0.##") ч за @Model.MonthStart.ToString("LLLL yyyy", ru).
        Введите часы напротив даты. Пустое поле или 0 = выходной.
    </p>

    <table style="max-width:560px">
        <thead>
            <tr><th>Дата</th><th>День</th><th>Часы</th></tr>
        </thead>
        <tbody>
        @foreach (var day in Model.Days)
        {
            <tr>
                <td>@day.Date.ToString("d MMMM", ru)</td>
                <td class="muted">@day.Date.ToString("ddd", ru)</td>
                <td>
                    <input type="hidden" name="Dates" value="@day.Date.ToString("yyyy-MM-dd")" />
                    <input type="text" inputmode="decimal" autocomplete="off" name="Hours"
                           value="@(day.Hours > 0 ? day.Hours.ToString("0.##") : "")"
                           style="width:100px" />
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="actions" style="margin-top:1rem">
        <button class="btn" type="submit">Сохранить</button>
    </div>
</form>

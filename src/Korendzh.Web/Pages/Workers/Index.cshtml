@page
@model Korendzh.Web.Pages.Workers.IndexModel
@{
    ViewData["Title"] = "Воркеры";
}
<div class="toolbar">
    <h1>Воркеры</h1>
    <a class="btn" asp-page="/Workers/Create">+ Пригласить воркера</a>
</div>

<table>
    <thead><tr><th>ФИО</th><th>Email</th><th>Подразделение</th><th>Активен</th><th></th></tr></thead>
    <tbody>
    @foreach (var w in Model.Items)
    {
        <tr>
            <td>@w.FullName</td>
            <td>@w.Email</td>
            <td>@(Model.DivisionNames.GetValueOrDefault(w.DivisionId ?? Guid.Empty) ?? "—")</td>
            <td>@(w.IsActive ? "да" : "нет")</td>
            <td class="actions">
                <a class="btn secondary" asp-page="/Workers/Edit" asp-route-id="@w.Id">Изменить</a>
                <form method="post" asp-page-handler="ResetPassword" asp-route-id="@w.Id" style="display:inline">
                    <button class="btn secondary" type="submit">Сброс пароля</button>
                </form>
                <form method="post" asp-page-handler="Toggle" asp-route-id="@w.Id" style="display:inline">
                    <button class="btn @(w.IsActive ? "danger" : "")" type="submit">@(w.IsActive ? "Деактивировать" : "Активировать")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

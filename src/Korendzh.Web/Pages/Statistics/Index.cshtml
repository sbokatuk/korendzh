@page
@model Korendzh.Web.Pages.Statistics.IndexModel
@{
    ViewData["Title"] = "Статистика";
}
<h1>Статистика</h1>

<form method="get" class="card">
    <div class="row">
        <div class="field">
            <label>Срез</label>
            <select name="by">
                <option value="worker" selected="@(Model.By == "worker")">По воркерам</option>
                <option value="task" selected="@(Model.By == "task")">По задачам</option>
                <option value="car" selected="@(Model.By == "car")">По автомобилям</option>
            </select>
        </div>
        <div class="field">
            <label>От</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label>До</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        @if (Model.IsAdmin)
        {
            <div class="field">
                <label>Подразделение</label>
                <select name="divisionId">
                    <option value="">— все —</option>
                    @foreach (var d in Model.Divisions)
                    {
                        <option value="@d.Id" selected="@(Model.DivisionId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
        }
        <div class="field" style="align-self:end">
            <button class="btn" type="submit">Применить</button>
        </div>
    </div>
    <div class="actions">
        <a class="btn secondary" asp-page-handler="Csv"
           asp-route-by="@Model.By" asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-divisionId="@Model.DivisionId">
            CSV
        </a>
        <a class="btn secondary" asp-page-handler="Xlsx"
           asp-route-by="@Model.By" asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-divisionId="@Model.DivisionId">
            Excel (xlsx)
        </a>
    </div>
</form>

@if (Model.Buckets.Any())
{
    <div class="card">
        <canvas id="statsChart" height="100"></canvas>
    </div>
}

<table>
    <thead><tr><th>Метка</th><th>Часы</th></tr></thead>
    <tbody>
        @foreach (var b in Model.Buckets)
        {
            <tr><td>@b.Label</td><td>@b.Hours.ToString("0.##")</td></tr>
        }
        @if (!Model.Buckets.Any())
        {
            <tr><td colspan="2" class="muted">Нет данных за выбранный период.</td></tr>
        }
    </tbody>
    <tfoot>
        <tr><th>Итого</th><th>@Model.Buckets.Sum(b => b.Hours).ToString("0.##")</th></tr>
    </tfoot>
</table>

@section Scripts {
    @if (Model.Buckets.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Buckets.Select(b => b.Label)));
            const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Buckets.Select(b => (double)b.Hours)));
            const ctx = document.getElementById('statsChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Часы',
                        data,
                        backgroundColor: 'rgba(29, 78, 216, 0.6)',
                        borderColor: 'rgba(29, 78, 216, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        </script>
    }
}

@page
@model Korendzh.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Кабинет";
}
<h1>Здравствуйте, @Model.FullName!</h1>
<p>Вы вошли как <strong>@Model.Role</strong>.</p>
<div class="actions" style="margin-top:16px">
    <a class="btn" asp-page="/TimeEntries/Index">Табель</a>
    <a class="btn secondary" asp-page="/Plan/Index">Мой план</a>
    @if (Model.IsManagerOrAdmin)
    {
        <a class="btn secondary" asp-page="/Workers/Index">Работники</a>
        <a class="btn secondary" asp-page="/Plan/Workers">Планы</a>
        <a class="btn secondary" asp-page="/Cars/Index">Автомобили</a>
        <a class="btn secondary" asp-page="/Statistics/Index">Статистика</a>
        <a class="btn secondary" asp-page="/Statistics/Plan">План vs Факт</a>
    }
    @if (Model.IsAdmin)
    {
        <a class="btn secondary" asp-page="/Admin/Managers/Index">Менеджеры</a>
        <a class="btn secondary" asp-page="/Admin/Divisions/Index">Подразделения</a>
        <a class="btn secondary" asp-page="/Admin/Cms/SiteSettings">Настройки сайта</a>
        <a class="btn secondary" asp-page="/Admin/Cms/Services/Index">Услуги (CMS)</a>
        <a class="btn secondary" asp-page="/Admin/Cms/Reviews/Index">Отзывы (CMS)</a>
        <a class="btn secondary" asp-page="/Admin/Cms/Pages/Index">Страницы (CMS)</a>
    }
</div>

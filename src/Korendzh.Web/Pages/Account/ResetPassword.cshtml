@page
@model Korendzh.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Сброс пароля";
}
<div class="card" style="max-width:420px;margin:1rem auto;">
    <h1>Новый пароль</h1>
    @if (Model.Failed)
    {
        <div class="error">Ссылка для сброса пароля недействительна или истекла. <a asp-page="/Account/ForgotPassword">Запросить новую</a>.</div>
    }
    else if (Model.Done)
    {
        <p>Пароль успешно изменён. <a asp-page="/Account/Login">Войти</a></p>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <div class="field">
                <label asp-for="Input.Password">Новый пароль</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword">Подтверждение</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>
            <button type="submit" class="btn">Сменить пароль</button>
        </form>
    }
</div>

@page
@model Korendzh.Web.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "Внешний вход";
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="card" style="max-width:520px;margin:1rem auto;">
        <h1>Не удалось войти через провайдера</h1>
        <div class="error">@Model.ErrorMessage</div>
        <p><a asp-page="/Account/Login">← к обычному входу</a></p>
    </div>
}

@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}
<div class="card" style="max-width:420px;margin:1rem auto;">
    <h1>Восстановление пароля</h1>
    @if (Model.Submitted)
    {
        <p>Если такой email существует, мы отправили на него ссылку для сброса пароля. Проверьте почту.</p>
        <p><a asp-page="/Account/Login">← к входу</a></p>
    }
    else
    {
        <form method="post">
            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" required />
            </div>
            <button type="submit" class="btn">Отправить ссылку</button>
        </form>
    }
</div>

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject Microsoft.Extensions.Options.IOptions<Korendzh.Web.Configuration.AppOptions> AppOpt
@{
    var trackingOnly = AppOpt.Value.IsTrackingOnly;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · АрВи-транс</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar">
    <div class="brand"><a asp-page="/Dashboard/Index">АрВи-транс · Кабинет</a></div>
    <nav class="navmain">
        @if (SignInManager.IsSignedIn(User))
        {
            var user = await UserManager.GetUserAsync(User);
            var isAdmin = User.IsInRole(Roles.Admin);
            var isManager = User.IsInRole(Roles.Manager);

            <a asp-page="/TimeEntries/Index">Табель</a>
            <a asp-page="/Plan/Index">Мой план</a>
            @if (isManager || isAdmin)
            {
                <a asp-page="/Workers/Index">Работники</a>
                <a asp-page="/Plan/Workers">Планы</a>
                <a asp-page="/Cars/Index">Автомобили</a>
                <a asp-page="/Statistics/Index">Статистика</a>
                <a asp-page="/Statistics/Plan">План vs Факт</a>
            }
            @if (isAdmin)
            {
                <a asp-page="/Admin/Managers/Index">Мастера</a>
                <a asp-page="/Admin/Divisions/Index">Подразделения</a>
                @if (!trackingOnly)
                {
                    <a asp-page="/Admin/Cms/SiteSettings">Сайт</a>
                    <a asp-page="/Admin/Cms/Services/Index">Услуги</a>
                    <a asp-page="/Admin/Cms/Reviews/Index">Отзывы</a>
                    <a asp-page="/Admin/Cms/Pages/Index">Страницы</a>
                }
                <a asp-page="/Admin/EmailTest">Тест email</a>
            }
            <span class="user">@(user?.FullName ?? User.Identity?.Name)</span>
            @if (!trackingOnly)
            {
                <a asp-page="/Index" style="margin-left:8px">→ Сайт</a>
            }
            <form method="post" asp-page="/Account/Logout" style="display:inline">
                <button type="submit" class="linklike">Выйти</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login">Войти</a>
        }
    </nav>
</header>
<main class="container">
    @if (TempData["StatusMessage"] is string msg && !string.IsNullOrEmpty(msg))
    {
        <div class="status">@msg</div>
    }
    @RenderBody()
</main>
<footer class="footer">
    <span>АрВи-транс · @DateTime.UtcNow.Year</span>
</footer>
@RenderSection("Scripts", required: false)
</body>
</html>

@page "/p/{slug}"
@model Korendzh.Web.Pages.Pages.ViewModel
@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = Model.Item?.Title ?? "Страница";
}

<section class="section">
    <div class="container">
        @if (Model.Item is null)
        {
            <h1>Страница не найдена</h1>
            <p><a asp-page="/Index">← На главную</a></p>
        }
        else
        {
            <article class="prose">
                <h1>@Model.Item.Title</h1>
                @Html.Raw(Model.Item.ContentHtml)
            </article>
        }
    </div>
</section>

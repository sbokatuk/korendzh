@page "/contacts"
@model Korendzh.Web.Pages.Contacts.IndexModel
@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "Контакты";
    var s = Model.Settings;
}

<section class="section">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow">Где нас найти</div>
            <h2>Контакты</h2>
            <p>Звоните, пишите, приезжайте — постараемся ответить быстро.</p>
        </div>

        <div class="contacts-grid">
            <div class="contact-block">
                <h3>Адрес</h3>
                @if (!string.IsNullOrEmpty(s.Address))
                {
                    <div class="label">Где мы</div>
                    <p>@s.Address</p>
                }
                <div class="label">Режим работы</div>
                <p>@s.WorkingHours</p>
            </div>
            <div class="contact-block">
                <h3>Связь</h3>
                @if (!string.IsNullOrEmpty(s.Phone))
                {
                    <div class="label">Телефон</div>
                    <p style="font-size:20px"><a href="tel:@s.Phone.Replace(" ", "")">@s.Phone</a></p>
                }
                @if (!string.IsNullOrEmpty(s.Email))
                {
                    <div class="label">Email</div>
                    <p><a href="mailto:@s.Email">@s.Email</a></p>
                }
                @{
                    var hasSocial =
                        !string.IsNullOrEmpty(s.InstagramUrl) ||
                        !string.IsNullOrEmpty(s.TelegramUrl) ||
                        !string.IsNullOrEmpty(s.VkUrl);
                }
                @if (hasSocial)
                {
                    <div class="label">Социальные сети</div>
                    <p class="socials">
                        @if (!string.IsNullOrEmpty(s.InstagramUrl))
                        {
                            <a href="@s.InstagramUrl">Instagram</a>
                        }
                        @if (!string.IsNullOrEmpty(s.TelegramUrl))
                        {
                            <a href="@s.TelegramUrl">Telegram</a>
                        }
                        @if (!string.IsNullOrEmpty(s.VkUrl))
                        {
                            <a href="@s.VkUrl">ВКонтакте</a>
                        }
                    </p>
                }
            </div>
        </div>
    </div>
</section>

@page "{id:guid}"
@model Korendzh.Web.Pages.Admin.Cms.Reviews.EditModel
@{
    ViewData["Title"] = "Изменить отзыв";
}
<h1>Изменить отзыв</h1>
@if (Model.Target is null)
{
    <div class="error">Не найдено.</div>
}
else
{
    <form method="post" enctype="multipart/form-data" class="card" style="max-width:680px">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <div class="row">
            <div class="field">
                <label asp-for="Input.AuthorName">Имя автора</label>
                <input asp-for="Input.AuthorName" type="text" maxlength="150" required />
            </div>
            <div class="field">
                <label asp-for="Input.ReviewDate">Дата</label>
                <input asp-for="Input.ReviewDate" type="date" required />
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.Text">Текст</label>
            <textarea asp-for="Input.Text" maxlength="2000" rows="5" required></textarea>
        </div>

        <div class="row">
            <div class="field">
                <label asp-for="Input.Rating">Оценка</label>
                <input asp-for="Input.Rating" type="number" min="0" max="5" />
            </div>
            <div class="field">
                <label asp-for="Input.DisplayOrder">Порядок</label>
                <input asp-for="Input.DisplayOrder" type="number" min="0" />
            </div>
        </div>

        <div class="field">
            <label>Фото автора</label>
            @if (!string.IsNullOrEmpty(Model.Target.AuthorPhotoUrl))
            {
                <div style="margin-bottom:8px"><img src="@Model.Target.AuthorPhotoUrl" style="max-width:120px;border-radius:50%" /></div>
                <label><input type="checkbox" name="ClearPhoto" value="true" /> Удалить фото</label>
            }
            <input type="file" name="PhotoFile" accept="image/*" />
        </div>

        <div class="field">
            <label><input type="checkbox" asp-for="Input.IsPublished" /> Опубликован</label>
        </div>

        <div class="actions">
            <button class="btn" type="submit">Сохранить</button>
            <a class="btn secondary" asp-page="Index">Отмена</a>
        </div>
    </form>
}

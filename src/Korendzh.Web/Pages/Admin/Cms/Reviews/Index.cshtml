@page
@model Korendzh.Web.Pages.Admin.Cms.Reviews.IndexModel
@{
    ViewData["Title"] = "Отзывы (CMS)";
}
<div class="toolbar">
    <h1>Отзывы</h1>
    <a class="btn" asp-page="/Admin/Cms/Reviews/Create">+ Добавить отзыв</a>
</div>

<table>
    <thead><tr><th>Автор</th><th>Дата</th><th>Оценка</th><th>Опубл.</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Items)
    {
        <tr>
            <td>@r.AuthorName</td>
            <td>@r.ReviewDate.ToString("yyyy-MM-dd")</td>
            <td>@r.Rating / 5</td>
            <td>@(r.IsPublished ? "✓" : "—")</td>
            <td class="actions">
                <a class="btn secondary" asp-page="/Admin/Cms/Reviews/Edit" asp-route-id="@r.Id">Изменить</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" style="display:inline">
                    <button class="btn danger" type="submit" onclick="return confirm('Удалить отзыв?')">Удалить</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Items.Any())
    {
        <tr><td colspan="5" class="muted">Отзывов пока нет.</td></tr>
    }
    </tbody>
</table>

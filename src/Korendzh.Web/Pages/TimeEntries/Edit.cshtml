@page "{id:guid}"
@model Korendzh.Web.Pages.TimeEntries.EditModel
@{
    ViewData["Title"] = "Изменить запись";
}
<h1>Изменить запись</h1>

@if (Model.EntryNotFound)
{
    <div class="error">Запись не найдена или удалена.</div>
}
else
{
    <form method="post" class="card">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.RowVersion" />
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <div class="row">
            <div class="field">
                <label asp-for="Input.WorkDate">Дата</label>
                <input asp-for="Input.WorkDate" type="date" required />
                <span asp-validation-for="Input.WorkDate"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Hours">Часы</label>
                <input asp-for="Input.Hours" type="text" inputmode="decimal" autocomplete="off" required placeholder="например, 1.5 или 1,5" />
                <span asp-validation-for="Input.Hours"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.TaskName">Задача</label>
            <input asp-for="Input.TaskName" type="text" maxlength="200" />
        </div>

        <div class="row">
            <div class="field">
                <label asp-for="Input.CarName">Автомобиль</label>
                <input asp-for="Input.CarName" type="text" maxlength="100" list="cars-datalist" autocomplete="off" />
                <datalist id="cars-datalist"></datalist>
            </div>
            <div class="field">
                <label asp-for="Input.LicensePlate">Госномер</label>
                <input asp-for="Input.LicensePlate" type="text" maxlength="20" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.Description">Описание</label>
            <textarea asp-for="Input.Description" maxlength="500"></textarea>
        </div>

        <div class="actions">
            <button class="btn" type="submit">Сохранить</button>
            <a class="btn secondary" asp-page="/TimeEntries/Index">Отмена</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            const carInput = document.querySelector('input[name="Input.CarName"]');
            const plateInput = document.querySelector('input[name="Input.LicensePlate"]');
            const datalist = document.getElementById('cars-datalist');
            if (!carInput || !plateInput || !datalist) return;

            const cache = new Map();
            let lastSuggestedPlate = '';
            let lastQuery = '';

            async function fetchAndPopulate(q) {
                const resp = await fetch('/api/cars/autocomplete?q=' + encodeURIComponent(q));
                if (!resp.ok) return;
                const items = await resp.json();
                datalist.innerHTML = '';
                items.forEach(it => {
                    cache.set(it.name.toLowerCase(), it);
                    const opt = document.createElement('option');
                    opt.value = it.name;
                    opt.label = it.licensePlate ? (it.name + ' · ' + it.licensePlate) : it.name;
                    datalist.appendChild(opt);
                });
            }

            function tryAutoFillPlate() {
                const name = carInput.value.trim().toLowerCase();
                const match = cache.get(name);
                if (!match || !match.licensePlate) return;
                if (plateInput.value === '' || plateInput.value === lastSuggestedPlate) {
                    plateInput.value = match.licensePlate;
                    lastSuggestedPlate = match.licensePlate;
                }
            }

            carInput.addEventListener('input', async (e) => {
                const q = e.target.value.trim();
                if (q.length >= 2 && q !== lastQuery) {
                    lastQuery = q;
                    await fetchAndPopulate(q);
                }
                tryAutoFillPlate();
            });
            carInput.addEventListener('change', tryAutoFillPlate);
            carInput.addEventListener('blur', tryAutoFillPlate);
        })();
    </script>
}

@page
@model Korendzh.Web.Pages.TimeEntries.CreateModel
@{
    ViewData["Title"] = "Новая запись";
}
<h1>Новая запись</h1>

<form method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="actions" style="margin-bottom:1.25rem">
        <button class="btn" type="submit">Сохранить</button>
        <a class="btn secondary" asp-page="/TimeEntries/Index">Отмена</a>
    </div>

    <div class="field">
        <label asp-for="Input.Hours" style="font-size:1.05rem">Часы <span style="color:#b91c1c">*</span></label>
        <input asp-for="Input.Hours"
               type="text"
               inputmode="decimal"
               autocomplete="off"
               autofocus
               required
               placeholder="например, 1.5 или 1,5"
               style="font-size:1.25rem;font-weight:600" />
        <small class="muted">Единственное обязательное поле. Допускаются и точка, и запятая.</small>
        <span asp-validation-for="Input.Hours"></span>
    </div>

    <div class="row">
        <div class="field">
            <label asp-for="Input.WorkDate">Дата</label>
            <input asp-for="Input.WorkDate" type="date" />
        </div>
        @if (Model.IsManagerOrAdmin)
        {
            <div class="field">
                <label asp-for="Input.WorkerId">Работник</label>
                <select asp-for="Input.WorkerId">
                    <option value="">— я сам —</option>
                    @foreach (var w in Model.Workers)
                    {
                        <option value="@w.Id">@w.FullName</option>
                    }
                </select>
            </div>
        }
    </div>

    @* Поле «Задача» временно скрыто (значение всё равно биндится — пустое).
       Чтобы вернуть UI — раскомментировать ниже и удалить hidden-инпут. *@
    <input type="hidden" asp-for="Input.TaskName" />
    @*
    <div class="field">
        <label asp-for="Input.TaskName">Задача</label>
        <input asp-for="Input.TaskName" type="text" maxlength="200" />
    </div>
    *@

    <div class="row">
        <div class="field">
            <label asp-for="Input.CarName">Автомобиль</label>
            <input asp-for="Input.CarName" type="text" maxlength="100" list="cars-datalist" autocomplete="off" />
            <datalist id="cars-datalist"></datalist>
            @if (Model.RecentCars.Count > 0)
            {
                <div class="recent-cars" style="margin-top:6px">
                    @foreach (var c in Model.RecentCars)
                    {
                        <button type="button" class="chip"
                                data-name="@c.Name"
                                data-plate="@(c.LicensePlate ?? "")">
                            @c.Name@(string.IsNullOrEmpty(c.LicensePlate) ? "" : " · " + c.LicensePlate)
                        </button>
                    }
                </div>
            }
        </div>
        <div class="field">
            <label asp-for="Input.LicensePlate">Госномер</label>
            <input asp-for="Input.LicensePlate" type="text" maxlength="20" />
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.Description">Описание</label>
        <textarea asp-for="Input.Description" maxlength="500"></textarea>
    </div>
</form>

@section Scripts {
    <script>
        // На клиенте мягко нормализуем ввод часов: запрещаем буквы, разрешаем цифры, '.' и ','.
        // Серверный парсер всё равно принимает оба разделителя.
        (function () {
            const hoursInput = document.querySelector('input[name="Input.Hours"]');
            if (!hoursInput) return;
            hoursInput.addEventListener('input', () => {
                // Оставляем только цифры, '.', ','. Лишние разделители схлопываем.
                let v = hoursInput.value.replace(/[^\d.,]/g, '');
                // Не больше одного разделителя.
                const firstSep = v.search(/[.,]/);
                if (firstSep !== -1) {
                    v = v.substring(0, firstSep + 1) + v.substring(firstSep + 1).replace(/[.,]/g, '');
                }
                if (v !== hoursInput.value) hoursInput.value = v;
            });
        })();

        // Автокомплит автомобилей + автозаполнение госномера при выборе из подсказок.
        (function () {
            const carInput = document.querySelector('input[name="Input.CarName"]');
            const plateInput = document.querySelector('input[name="Input.LicensePlate"]');
            const datalist = document.getElementById('cars-datalist');
            if (!carInput || !plateInput || !datalist) return;

            const cache = new Map(); // name (lowercase) → {name, licensePlate}
            let lastSuggestedPlate = '';
            let lastQuery = '';

            async function fetchAndPopulate(q) {
                const resp = await fetch('/api/cars/autocomplete?q=' + encodeURIComponent(q));
                if (!resp.ok) return [];
                const items = await resp.json();
                datalist.innerHTML = '';
                items.forEach(it => {
                    cache.set(it.name.toLowerCase(), it);
                    const opt = document.createElement('option');
                    opt.value = it.name;
                    opt.label = it.licensePlate ? (it.name + ' · ' + it.licensePlate) : it.name;
                    datalist.appendChild(opt);
                });
                return items;
            }

            function tryAutoFillPlate() {
                const name = carInput.value.trim().toLowerCase();
                const match = cache.get(name);
                if (!match) return;
                if (!match.licensePlate) return;
                if (plateInput.value === '' || plateInput.value === lastSuggestedPlate) {
                    plateInput.value = match.licensePlate;
                    lastSuggestedPlate = match.licensePlate;
                }
            }

            carInput.addEventListener('input', async (e) => {
                const q = e.target.value.trim();
                if (q.length >= 2 && q !== lastQuery) {
                    lastQuery = q;
                    await fetchAndPopulate(q);
                }
                tryAutoFillPlate();
            });
            carInput.addEventListener('change', tryAutoFillPlate);
            carInput.addEventListener('blur', tryAutoFillPlate);
        })();

        // Быстрый выбор последних автомобилей.
        document.querySelectorAll('.recent-cars button.chip').forEach(btn => {
            btn.addEventListener('click', () => {
                const carInput = document.querySelector('input[name="Input.CarName"]');
                const plateInput = document.querySelector('input[name="Input.LicensePlate"]');
                if (carInput) carInput.value = btn.dataset.name;
                if (plateInput) plateInput.value = btn.dataset.plate || '';
                if (carInput) carInput.dispatchEvent(new Event('input', { bubbles: true }));
            });
        });
    </script>
}
